{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "assignees": [
    "colby.goettel"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group sqflite family — versions must stay in sync",
      "matchPackageNames": [
        "sqflite",
        "sqflite_common_ffi",
        "sqflite_common_ffi_web"
      ],
      "groupName": "sqflite"
    },
    {
      "description": "Flutter CI images (Android for tests and the APK, web for Pages): bump together, linked to Flutter release notes",
      "matchPackageNames": ["ghcr.io/gmeligio/flutter-android", "ghcr.io/gmeligio/flutter-web"],
      "groupName": "flutter ci images",
      "sourceUrl": "https://github.com/flutter/flutter"
    },
    {
      "description": "Flutter's settings plugin loader ships inside the Flutter SDK and is never published to Maven, so every lookup fails with a dashboard warning",
      "matchPackageNames": ["dev.flutter.flutter-plugin-loader"],
      "enabled": false
    },
    {
      "description": "Auto-merge patch updates when CI passes",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
